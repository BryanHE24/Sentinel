# .aceconfig - ACE Framework Configuration
# Version: 2.7.0

version: "2.7.0"
project_name: "sentinel"

# Expansion Packs (Modular config loading)
includes: []

# Entry point for AI agents - files always loaded
entry:
  standards:
    - .ace/standards/pyspark-associate-level.md
    - .ace/standards/coding.md
    - .ace/standards/security.md
  roles: .ace/roles/roles.md

# Critical rules (always in context - keep under 500 tokens)
core_rules:
  - "Never commit secrets, credentials, or API keys"
  - "All code must pass linting before commit"
  - "Follow patterns established in docs/adr/"
  - "Update ACTIVE_CONTEXT.md after each session"
  - "Verify against .ace/standards/ before completing any task"
  - "Generate IMPLEMENTATION_PLAN.md before writing code"
  - "Write PySpark at Associate level: follow .ace/standards/pyspark-associate-level.md; if a requirement seems to need advanced code, propose the simpler version and ask first"
  - "Every task follows BMAD: Analyze → Discuss → Plan → Execute → Verify"
  - "Create ADR for any significant architectural decision"
  - "Atomic commits with clear, descriptive messages"
  - "No code generation without reading existing code first"
  - "Check regression guards before modifying any guarded file"
  - "Every Medium-or-higher issue requires RCA with regression prevention"

# Task-to-skill mapping (auto-load relevant skill)
# Trimmed for Sentinel: removed generic keywords (feature, state, model, agent, mcp,
# performance, accessibility ...) that also appear in normal Databricks vocabulary and
# loaded ML, React or agent skills that push complex code.
skill_triggers:
  pyspark: .ace/standards/pyspark-associate-level.md
  spark: .ace/standards/pyspark-associate-level.md
  notebook: .ace/standards/pyspark-associate-level.md
  databricks: .ace/standards/pyspark-associate-level.md
  database: .ace/skills/database-operations/SKILL.md
  api: .ace/skills/api-design/SKILL.md
  testing: .ace/skills/testing-strategy/SKILL.md
  migration: .ace/skills/migration-logic/SKILL.md
  refactor: .ace/skills/refactoring/SKILL.md
  review: .ace/skills/code-review/SKILL.md
  transcript: .ace/skills/transcript-analysis/SKILL.md
  issue: .ace/skills/root-cause-analysis/SKILL.md
  bug: .ace/skills/root-cause-analysis/SKILL.md
  incident: .ace/skills/root-cause-analysis/SKILL.md
  pipeline: .ace/skills/data-pipeline-design/SKILL.md
  prompt: .ace/skills/prompt-engineering/SKILL.md
  security: .ace/skills/security-audit/SKILL.md
  cicd: .ace/skills/ci-cd-pipeline/SKILL.md
  error: .ace/skills/error-handling/SKILL.md
  documentation: .ace/skills/documentation-generation/SKILL.md
  azure: .ace/skills/az-devops-setup/SKILL.md
  ado: .ace/skills/az-devops-setup/SKILL.md
  workitem: .ace/skills/az-create-work-item/SKILL.md
  backlog: .ace/skills/az-read-work-item/SKILL.md
  board: .ace/skills/az-read-work-item/SKILL.md

# Role routing based on mode
role_routing:
  PLANNING: Architect
  EXECUTION: Developer
  VERIFICATION: QA Engineer
  INCIDENT: Incident Responder
  RESEARCH: Data Scientist
  PUBLICATION: Scientific Editor

# Verification gate (v2.7 Loop Engineering)
# Read by .ace/scripts/verify.sh. Constraint: flat `key: "value"` lines only
# (parsed from bash with sed, no YAML parser). Empty values are skipped;
# if ALL commands are empty/missing, verify.sh fails - an unconfigured
# gate must never silently pass.
# Automated verification is not configured yet.
# Databricks checks are executed manually and their results recorded.
# Empty commands intentionally keep ACE's automated gate unconfigured.
verify:
  test_cmd: ""
  lint_cmd: ""
  typecheck_cmd: ""

# Validation hooks
hooks:
  pre_generation:
    - check_active_context
    - load_relevant_adrs
    - check_regression_guards
  post_generation:
    - validate_against_standards
    - verify_regression_invariants
    - run_regression_tests
    - update_active_context
  pre_commit:
    - lint
    - test
    - regression_tests
    - security_scan
    - guard_compliance_check
  on_issue:
    - create_incident
    - capture_evidence
  post_rca:
    - create_regression_guard
    - update_standards
    - verify_regression_tests

# Context management
context:
  active_context_path: docs/context/ACTIVE_CONTEXT.md
  planning_path: docs/planning/
  rca_path: docs/rca/
  max_context_files: 5
  auto_load_adrs: true
  auto_load_guards: true

# RCA and Regression Prevention
rca:
  template: docs/rca/RCA-000-template.md
  guards_file: docs/rca/regression-guards.yaml
  require_tests: true
  require_guard: true
  require_standard_update: true

# Feedback and metrics
feedback:
  log_path: .ace/feedback/log.md
  track_prompt_success: true
  track_violations: true
  track_regressions: true
